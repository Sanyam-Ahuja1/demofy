# Server Configuration
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://farmer_dairy:farmer_dairy_dev_pass@localhost:5432/farmer_dairy?schema=public

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:19006

# Rate Limiting (Optional - Redis for production)
# REDIS_URL=redis://localhost:6379

# OTP Configuration
OTP_EXPIRY_MINUTES=15
OTP_LENGTH=6

# OTP Provider (console | twilio | aws-sns)
OTP_PROVIDER=console

# Twilio (if using Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# AWS SNS (if using AWS SNS)
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Object Storage (for product images)
# Configure based on your provider (GCS, S3, DigitalOcean Spaces)
# Images will be stored as URLs in the database
STORAGE_BUCKET_URL=https://storage.example.com/Farmer-Dairy

# Admin Default Credentials (for initial setup)
ADMIN_EMAIL=admin@Farmer-Dairy.com
ADMIN_PASSWORD=changeme123
